---
const { kind = 'field' } = Astro.props;
const dots = Array.from({length: 460}, (_,i) => { const y = 1 - (i / 459) * 2; const r = Math.sqrt(1-y*y); const a = i * 2.399963; return {x: 300 + Math.cos(a)*r*180, y: 220+y*180, z: Math.sin(a)*r}; });
---
<div class:list={['art', kind]} aria-hidden="true" transition:name={`art-${kind}`}>
<svg viewBox="0 0 600 440" fill="none">
{kind === 'field' && <g>{dots.map(p => <circle cx={p.x} cy={p.y} r={1.4 + (p.z+1)*1.3} fill="currentColor" opacity={.25+(p.z+1)*.35}/>)}</g>}
{kind === 'bars' && <g>{Array.from({length:45},(_,i)=><path d={`M ${80+i*10} 340 V ${100+Math.sin(i*.14)*75+Math.cos(i*.33)*35}`} stroke="currentColor" stroke-width="4"/>)}</g>}
{kind === 'loops' && <g>{Array.from({length:22},(_,i)=><ellipse cx="300" cy="220" rx={70+i*6} ry={150-i*4.7} transform={`rotate(${i*5} 300 220)`} stroke="currentColor" stroke-width="1.2"/>)}</g>}
</svg>
<span class="art-label">{kind === 'field' ? 'MODEL / 001' : kind === 'bars' ? 'SIGNAL / 002' : 'FEEDBACK / 003'}</span>
<span class="art-plus">+</span>
</div>
