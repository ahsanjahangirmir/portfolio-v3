---
import { ClientRouter } from 'astro:transitions';
import { site, projects, href } from '../data/site';
import '../styles/site.css';
import '../styles/theme.css';
const {title = 'Data into direction', description = site.description} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(href('/og.png'), Astro.site);
const contacts = [
  {label: 'Email', value: site.email, url: 'mailto:' + site.email},
  {label: 'Book a call', value: '30 minutes on Calendly', url: site.links.calendly, external: true},
  {label: 'GitHub', value: '@ahsanjahangirmir', url: site.links.github, external: true},
  {label: 'LinkedIn', value: 'in/ahsanjahangirmir', url: site.links.linkedin, external: true},
];
const person = {
  '@context': 'https://schema.org', '@type': 'Person', name: site.name, jobTitle: site.role, url: site.url,
  email: 'mailto:' + site.email, sameAs: [site.links.github, site.links.linkedin],
};
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8"/>
<script is:inline>
  (() => {
    let theme = 'dark';
    try {
      const saved = localStorage.getItem('portfolio-navy-theme');
      if (saved === 'light' || saved === 'dark') theme = saved;
    } catch {}
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
  })();
</script><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{title} | {site.name}</title><meta name="description" content={description}/>
<link rel="canonical" href={canonical}/><meta name="theme-color" content="#060f1e"/>
<link rel="icon" type="image/svg+xml" href={href('/favicon.svg')}/>
<link rel="icon" href={href('/favicon.ico')} sizes="32x32"/>
<link rel="apple-touch-icon" href={href('/apple-touch-icon.png')}/>
<link rel="sitemap" href={href('/sitemap-index.xml')}/>
<link rel="preload" href={href('/fonts/instrument-sans-400-normal.woff2')} as="font" type="font/woff2" crossorigin/>
<link rel="preload" href={href('/fonts/instrument-sans-600-normal.woff2')} as="font" type="font/woff2" crossorigin/>
<meta name="author" content={site.name}/>
<meta property="og:title" content={title + ' | ' + site.name}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:image" content={ogImage}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:site_name" content={site.name}/><meta name="twitter:card" content="summary_large_image"/>
<script type="application/ld+json" set:html={JSON.stringify(person)}/>
<ClientRouter/>
</head>
<body>
<a href="#main" class="skip-link">Skip to content</a>
<header class="header wrap">
<a href={href('/')} class="brand"><span class="brand-mark" aria-hidden="true">a<span>j</span><span>m</span><i>.</i></span><span class="brand-name">{site.name}<small>{site.role}</small></span></a>
<div class="header-controls"><nav aria-label="Main navigation">
<a href={href('/#work')} class="nav-link"><span>Work</span><sup>{String(projects.length).padStart(2, '0')}</sup></a>
<a href={href('/#about')} class="nav-link">About</a>
<a href={href('/#contact')} class="nav-link">Let’s talk <span class="arrow">↗</span></a>
</nav>
<button class="theme-toggle" type="button" aria-label="Dark theme" aria-pressed="true" title="Switch color theme">
<svg class="theme-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
<svg class="theme-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.2A8.7 8.7 0 0 1 9.8 3.5a8.8 8.8 0 1 0 10.7 10.7Z"/></svg>
</button></div>
</header>
<main id="main" tabindex="-1"><slot/></main>
<footer id="contact" class="footer wrap">
<div class="footer-top"><span class="meta">HAVE SOMETHING IN MIND?</span><span class="meta">WRITE, OR TAKE 30 MINUTES ON MY CALENDAR.</span></div>
<a class="contact-title" href={'mailto:'+site.email}>Let’s make it<br/><span>make sense.</span><span class="contact-arrow" aria-hidden="true">↗</span></a>
<ul class="contact-links" aria-label="Contact and profiles">
{contacts.map(c => <li><a href={c.url} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener' : undefined}><span class="meta">{c.label.toUpperCase()}</span><span class="contact-value">{c.value} <span class="arrow" aria-hidden="true">↗</span></span>{c.external && <span class="sr-only"> (opens in a new tab)</span>}</a></li>)}
</ul>
<div class="footer-bottom"><span>© {new Date().getFullYear()} {site.name}</span><span>Set in Instrument Sans. Built with Astro.</span><a href="#main" class="to-top">Back to top <span class="arrow" aria-hidden="true">↑</span></a></div>
</footer>
<script>
import '../engine/site';
</script>
</body>
</html>
