---
import Base from '../../layouts/Base.astro';
import Art from '../../components/Art.astro';
import { projects } from '../../data/site';
export function getStaticPaths(){return projects.map((project,i)=>({params:{slug:project.slug},props:{project,next:projects[(i+1)%projects.length]}}))}
const {project,next}=Astro.props;
---
<Base title={project.title} description={project.detail+' An illustrative concept study in systems thinking and engineering.'}>
<section class="case wrap">
<a href="/#work" class="back-link">← All work</a>
<div class="case-meta meta">{project.category.toUpperCase()} <span>ILLUSTRATIVE CONCEPT STUDY</span></div>
<h1>{project.title}<span class="accent">.</span></h1><p class="case-summary">{project.detail}</p>
<div class="case-tags">{project.tags.map(tag=><span>{tag}</span>)}</div>
<Art kind={project.kind}/>
<div class="case-body"><div><h2>The question</h2><p>{project.context}</p></div><div><h2>The approach</h2><p>{project.idea}</p></div><div class="case-craft"><h2>Inside the system</h2><ul>{project.craft.map(item=><li><span class="status-dot orange"></span>{item}</li>)}</ul></div><div><h2>Where it leads</h2><p>{project.outcome}</p></div></div>
<aside class="study-note">This is a fictional project used to demonstrate the portfolio design. Replace it with your own work and verified outcomes before publishing.</aside>
<a class="next-project" href={'/work/'+next.slug+'/'}><span class="meta">NEXT STUDY</span><span>{next.title} <i>↗</i></span></a>
</section>
</Base>
